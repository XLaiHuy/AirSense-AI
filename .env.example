# AirSense AI - Environment Configuration

ENVIRONMENT=development
LOG_LEVEL=INFO

# Database & Cache (Docker Compose)
DATABASE_URL=postgresql://airsense:airsense_secure_pass@localhost:5432/airsense_db
REDIS_URL=redis://localhost:6379/0

# External Air Quality APIs
# Lấy API key miễn phí tại: https://explore.openaq.org/register
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# City Geolocation Default (TP.HCM)
DEFAULT_CITY=TP_HO_CHI_MINH
DEFAULT_LAT=10.7769
DEFAULT_LON=106.7009

# Ports
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Gemini AI Agent API Key
GEMINI_API_KEY=your_gemini_api_key_here
